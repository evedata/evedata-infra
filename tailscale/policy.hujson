{
	"groups": {
		"group:ansible": ["evedatabot@github"],
	},

	"tagOwners": {
		"tag:ansible":      [],
		"tag:hzl":          [],
		"tag:stg":          [],
		"tag:prd":          [],
		"tag:k8s-operator": [],
		"tag:k8s":          ["tag:k8s-operator"],
	},

	"grants": [
		{
			"src": ["autogroup:admin", "group:ansible"],
			"dst": ["tag:ansible"],
			"ip":  ["*"],
		},
		{
			"src": ["autogroup:admin", "tag:k8s"],
			"dst": ["tag:k8s-operator"],
			"app": {
				"tailscale.com/cap/kubernetes": [
					{
						"impersonate": {
							"groups": ["system:masters"],
						},
					},
				],
			},
		},
	],

	"ssh": [
		// Allow all users to SSH into their own devices in check mode.
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
		{
			"action": "accept",
			"dst":    ["tag:ansible"],
			"src":    ["group:ansible"],
			"users":  ["ansible"],
		},
	],
}
