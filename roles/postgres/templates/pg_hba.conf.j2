# PostgreSQL Client Authentication Configuration File
# Generated by Ansible - Do not edit manually
# Template: pg_hba.conf.j2

# TYPE  DATABASE        USER            ADDRESS                 METHOD

# "local" is for Unix domain socket connections only
local   all             postgres                                peer
local   all             all                                     peer

# IPv4 local connections:
host    all             postgres        127.0.0.1/32            {{ postgres_password_encryption }}
host    all             all             127.0.0.1/32            {{ postgres_password_encryption }}

# IPv6 local connections:
host    all             postgres        ::1/128                 {{ postgres_password_encryption }}
host    all             all             ::1/128                 {{ postgres_password_encryption }}

# Private network connections
{% for rule in postgres_ufw_rules %}
{% if rule.port == postgres_port %}
host    all             all             {{ rule.src }}          {{ postgres_password_encryption }}
{% endif %}
{% endfor %}

# Replication connections
local   replication     postgres                                peer
host    replication     postgres        127.0.0.1/32            {{ postgres_password_encryption }}
host    replication     postgres        ::1/128                 {{ postgres_password_encryption }}

# Monitoring connections
host    all             postgres        10.0.0.0/16             {{ postgres_password_encryption }}